# AI Service
# Switch providers by changing only these two lines. No code changes needed.
# Options: deepseek | qwen | moonshot | glm | openai
AI_PRIMARY_PROVIDER=deepseek
AI_FALLBACK_PROVIDER=qwen

# Optional: override the provider's default model.
# AI_MODEL_OVERRIDE=deepseek-reasoner

# API keys. Only fill in the providers you use.
DEEPSEEK_API_KEY=
QWEN_API_KEY=
MOONSHOT_API_KEY=
GLM_API_KEY=
OPENAI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# INTERNAL_ACCESS_USER / INTERNAL_ACCESS_PASSWORD:
# Optional Basic Auth gate for temporary internal tests and local tunnel sharing.
# Leave password empty to disable it during local development.
INTERNAL_ACCESS_USER="omiflow"
INTERNAL_ACCESS_PASSWORD=""

# REQUIRE_APP_AUTH:
# Leave false for local prototype work. Set true in shared/staging environments.
# Production always requires authentication even when this value is false.
REQUIRE_APP_AUTH="false"

# ALLOWED_ORIGINS:
# Optional comma-separated list for trusted cross-origin API callers.
# Same-origin browser requests are allowed automatically.
ALLOWED_ORIGINS=""

# OMNIFLOW_ADMIN_USER / OMNIFLOW_ADMIN_PASSWORD:
# Enables browser password login backed by a signed HttpOnly session cookie.
# Leave password empty only for local development.
OMNIFLOW_ADMIN_USER="omiflow"
OMNIFLOW_ADMIN_PASSWORD=""

# OMNIFLOW_SESSION_SECRET:
# Required for stable signed sessions in staging/production.
OMNIFLOW_SESSION_SECRET=""

# OMNIFLOW_SESSION_TTL_HOURS:
# Browser admin session lifetime.
OMNIFLOW_SESSION_TTL_HOURS="12"

# ADMIN_API_TOKEN:
# Optional server-side token for scripted API clients.
# Do not store this value in browser localStorage.
ADMIN_API_TOKEN=""
